{
  "select": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.overlay}"
    },
    "$type": "color",
    "trigger": {
      "background": {
        "$value": "{color.background}",
        "$extensions": {
          "plinth": {
            "modes": {
              "dark": "{color.input}"
            },
            "alpha": {
              "default": 0,
              "dark": 0.3
            }
          }
        }
      },
      "foreground": {
        "$value": "{color.foreground}"
      },
      "border": {
        "$value": "{color.input}"
      },
      "placeholder": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$description": "The chosen value",
        "$value": "{typography.body.md}"
      }
    },
    "content": {
      "background": {
        "$value": "{color.popover}"
      },
      "foreground": {
        "$value": "{color.popover-foreground}"
      },
      "border": {
        "$value": "{color.border}"
      },
      "radius": {
        "$type": "dimension",
        "$description": "The open list",
        "$value": "{select.radius}"
      }
    },
    "item": {
      "highlight-background": {
        "$value": "{color.accent}"
      },
      "highlight-foreground": {
        "$value": "{color.accent-foreground}"
      },
      "label": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$description": "Options in the list",
        "$value": "{typography.body.md}"
      },
      "radius": {
        "$type": "dimension",
        "$description": "Option corners: inside the list they fit its corners",
        "$value": "{radius.control}",
        "$extensions": {
          "plinth": {
            "fit": {
              "outer": "{select.content.radius}",
              "spacing": 1,
              "border": 1
            }
          }
        }
      }
    },
    "group-label": {
      "font": {
        "$type": "typography",
        "$description": "Group names in the list",
        "$value": "{typography.body.sm}"
      }
    }
  }
}
