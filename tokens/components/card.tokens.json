{
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.container}"
    },
    "$type": "color",
    "container": {
      "background": {
        "$value": "{color.card}"
      },
      "foreground": {
        "$value": "{color.card-foreground}"
      },
      "border": {
        "$value": "{color.foreground}",
        "$extensions": {
          "plinth": {
            "alpha": 0.1
          }
        }
      },
      "font": {
        "$type": "typography",
        "$description": "Text in the card",
        "$value": "{typography.body.md}"
      }
    },
    "description": {
      "foreground": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$description": "Card description",
        "$value": "{typography.body.md}"
      }
    },
    "footer": {
      "background": {
        "$value": "{color.muted}",
        "$extensions": {
          "plinth": {
            "alpha": 0.5
          }
        }
      }
    },
    "title": {
      "font": {
        "$type": "typography",
        "$description": "Card title",
        "$value": "{typography.heading.sm}"
      }
    },
    "title-small": {
      "font": {
        "$type": "typography",
        "$description": "Card title in the small card",
        "$value": "{typography.heading.xs}"
      }
    }
  }
}
