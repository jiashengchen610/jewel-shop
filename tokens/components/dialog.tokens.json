{
  "dialog": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.container}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.overlay}"
    },
    "$type": "color",
    "overlay": {
      "$value": "{color.foreground}",
      "$extensions": {
        "plinth": {
          "modes": {
            "dark": "{color.background}"
          },
          "alpha": {
            "default": 0.5,
            "dark": 0.8
          }
        }
      }
    },
    "content": {
      "background": {
        "$value": "{color.background}"
      },
      "foreground": {
        "$value": "{color.foreground}"
      },
      "border": {
        "$value": "{color.border}"
      }
    },
    "description": {
      "foreground": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$description": "Dialog text",
        "$value": "{typography.body.md}"
      }
    },
    "title": {
      "font": {
        "$type": "typography",
        "$description": "Dialog title",
        "$value": "{typography.heading.md}"
      }
    },
    "close": {
      "radius": {
        "$type": "dimension",
        "$description": "The close button in the corner",
        "$value": "{radius.small}",
        "$extensions": {
          "plinth": {
            "fit": {
              "outer": "{dialog.radius}",
              "spacing": 4,
              "border": 1,
              "min": "{radius.small}"
            }
          }
        }
      }
    }
  }
}
