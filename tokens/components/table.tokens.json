{
  "table": {
    "$type": "color",
    "border": {
      "$value": "{color.border}",
      "$description": "Line under each row"
    },
    "header": {
      "background": {
        "$value": "{color.muted}"
      },
      "foreground": {
        "$value": "{color.muted-foreground}"
      }
    },
    "row": {
      "foreground": {
        "$value": "{color.foreground}"
      },
      "background-hover": {
        "$value": "{color.muted}",
        "$description": "A body row under the pointer, or selected",
        "$extensions": {
          "plinth": {
            "alpha": 0.5
          }
        }
      }
    },
    "footer": {
      "background": {
        "$value": "{color.muted}",
        "$extensions": {
          "plinth": {
            "alpha": 0.5
          }
        }
      },
      "foreground": {
        "$value": "{color.foreground}"
      },
      "font": {
        "$type": "typography",
        "$value": "{typography.label.md}",
        "$description": "Totals in the footer"
      }
    },
    "head": {
      "font": {
        "$type": "typography",
        "$value": "{typography.label.md}",
        "$description": "Column titles"
      }
    },
    "cell": {
      "font": {
        "$type": "typography",
        "$value": "{typography.body.md}",
        "$description": "Cell text"
      }
    },
    "caption": {
      "foreground": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$value": "{typography.body.sm}",
        "$description": "Caption under the table"
      }
    }
  }
}
