{
  "tooltip": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.small}"
    },
    "$type": "color",
    "background": {
      "$value": "{color.foreground}"
    },
    "foreground": {
      "$value": "{color.background}"
    },
    "text": {
      "font": {
        "$type": "typography",
        "$description": "Tooltip text",
        "$value": "{typography.body.sm}"
      }
    }
  }
}
